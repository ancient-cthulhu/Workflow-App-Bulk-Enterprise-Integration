# GitHub App installed on every target org; a token is minted per org.
GITHUB_APP_ID=123456
# PEM text, one line with \n, or a path to the .pem file
GITHUB_APP_PRIVATE_KEY=/path/to/app.private-key.pem
# GHES only
# GITHUB_API_BASE=https://github.example.com/api/v3
# GITHUB_WEB_BASE=https://github.example.com
# Veracode admin user (--create-teams, --set-secrets, --link-teams-to-workspaces)
VERACODE_API_ID=
VERACODE_API_KEY=
# Veracode API service account, stored as org secrets (--set-secrets)
VERACODE_SA_API_ID=
VERACODE_SA_API_KEY=
